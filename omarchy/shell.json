          "chipColor": "#89b4fa",
          "fontSize": 14,
          "horizontalMargin": 10,
          "chipJoin": ""
        },
        {
          "id": "omarchy.weather",
          "chipColor": "#b4befe",
          "chipLead": "",
          "chipJoin": ""
        },
        {
          "id": "omarchy.audio",
          "chipColor": "#f9e2af",
          "chipLead": "",
          "chipJoin": ""
        },
        {
          "id": "michael.clock",
          "format": "dddd yyyy-MM-dd HH:mm:ss",
          "formatAlt": "dddd HH:mm",
          "verticalFormat": "HH\n—\nmm",
          "chipColor": "#a6e3a1",
          "chipRadius": "right",
          "chipLead": ""
        }
      ]
