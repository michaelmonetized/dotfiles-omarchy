          "chipJoin": ""
        },
        {
          "id": "michael.workspaces",
          "chipColor": "#f38ba8",
          "chipLead": "",
          "chipJoin": ""
        }
      ],
      "center": [],
      "right": [
        {
          "id": "omarchy.tray",
          "chipColor": "#cdd6f4",
          "chipLead": ""
        },
        {
          "id": "omarchy.system-update",
          "chipColor": "#cdd6f4"
        },
        {
          "id": "omarchy.indicators",
          "alwaysShow": true,
          "items": ["Dictation", "ScreenRecording", "StayAwake", "Dnd"],
          "chipColor": "#cdd6f4",
          "chipJoin": ""
        },
        {
          "id": "omarchy.bluetooth",
          "chipColor": "#89b4fa",
          "chipLead": ""
        },
        {
