[Unit]
Description=T3 Code server
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h
Environment=T3CODE_HOME=/home/michael/.t3
Environment=T3_BOOT_SERVICE_UNIT=t3code.service
ExecStart=/home/michael/.vite-plus/js_runtime/node/24.18.1/bin/node /home/michael/.t3/runtime/versions/0.0.31/node_modules/t3/dist/bin.mjs serve
Restart=always
RestartSec=5
StandardOutput=append:/home/michael/.t3/userdata/logs/boot-service.log
StandardError=append:/home/michael/.t3/userdata/logs/boot-service.log

[Install]
WantedBy=default.target
